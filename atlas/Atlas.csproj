<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Atlas</RootNamespace>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <!-- WHY: the core library and its tests are separate projects; keep their sources out of the Godot assembly. -->
  <ItemGroup>
    <Compile Remove="src/Core/**" />
    <Compile Remove="tests/**" />
    <None Remove="src/Core/**" />
    <None Remove="tests/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="src/Core/Atlas.Core.csproj" />
  </ItemGroup>
</Project>
